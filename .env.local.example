# football-data.org - free key at https://www.football-data.org/client/register
# Free plan: 12 competitions, 10 requests/minute.
# The app budgets 9/min and caches aggressively, so you do not need a paid plan.
FOOTBALL_DATA_API_KEY=your_key_here

# Admin auth (Watch CMS)
# AUTH_SECRET: a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is unset the app falls back to an insecure development default -
# always set it in production or admin sessions can be forged.
AUTH_SECRET=your_random_secret_here

# Seed admin account, created on first run if no users exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
