# football-data.org - free key at https://www.football-data.org/client/register
# Free plan: 12 competitions, 10 requests/minute.
FOOTBALL_DATA_API_KEY=

# ---- Neon Postgres ----
# Pooled connection (-pooler host) - used by the app at runtime.
DATABASE_URL=
# Direct connection (no -pooler) - used by Drizzle Kit for migrations only.
# The pooler cannot hold the session state DDL needs.
DATABASE_URL_UNPOOLED=

# ---- Admin ----
# Signs the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset, the app falls back to an insecure development default.
AUTH_SECRET=

# Seeds the FIRST admin account, and only while the users table is empty.
# Once that account exists these are inert, so leave them out of production
# entirely - a deployed secret that does nothing is only a liability.
#
# Do not use "admin" as the username. Netlify's build-time secret scanner
# searches the build output for each variable's value, and "admin" occurs in
# ordinary code and documentation (role: 'admin', /admin/streams), which fails
# the build with no real secret involved.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Protects /api/cron/sync. Point a scheduler at:
#   GET /api/cron/sync   with   Authorization: Bearer <this value>
# Unset, the route refuses every request.
CRON_SECRET=

# ---- Web Push (VAPID) ----
# Generate once with:
#   node --input-type=module -e "import {generateVAPIDKeys} from 'web-push'; console.log(generateVAPIDKeys())"
# The private key signs pushes and must stay secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Same value as VAPID_PUBLIC_KEY; exposed to the browser so it can subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# https:// or mailto: contact for push services. Empty = the deployed site URL.
VAPID_SUBJECT=

# TheSportsDB - crest fallbacks and player bios. Empty uses the free key "123"
# (the old key "3" is permanently disabled). Free tier: 30 req/min.
THESPORTSDB_API_KEY=
